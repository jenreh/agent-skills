{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "code-reasoning": {
        "command": "npx",
        "args": [
            "-y",
            "@mettamatt/code-reasoning"
        ]
    },
    "duckduckgo": {
        "command": "uvx",
        "args": [
            "duckduckgo-mcp-server"
        ]
    }
  }
}
